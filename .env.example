# FastAPI runtime
DECROCHAGE_MODEL_PATH=artifacts/models/model_bundle.joblib

# SQL persistence. Local default can be SQLite, production-like stack uses Postgres.
DECROCHAGE_DATABASE_URL=postgresql+psycopg://decrochage:change-me@localhost:5432/decrochage

# Required for RGPD pseudonymisation from Silver onward.
# Generate locally, keep secret, rotate through DPO-approved procedure.
DECROCHAGE_PSEUDONYMIZATION_SECRET=change-me-with-openssl-rand-hex-32

# Retention window for risk scores and medallion batches.
DECROCHAGE_RETENTION_DAYS=365

# Docker Compose Postgres settings.
POSTGRES_DB=decrochage
POSTGRES_USER=decrochage
POSTGRES_PASSWORD=change-me

# Optional. When set, clients must send this value as the X-API-Key header.
DECROCHAGE_API_KEY=

# Model lifecycle: MLflow aliases candidate/production/archived.
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
DECROCHAGE_REGISTERED_MODEL=decrochage-l1
DECROCHAGE_MODEL_ALIAS=production

# Public HTTPS endpoint handled by Caddy in the `run` Compose profile.
DECROCHAGE_DOMAIN=localhost

# Optional dead-man's switch for scheduled scoring/monitoring jobs.
DECROCHAGE_HEALTHCHECK_URL=

# Optional Grafana contact point (Teams/Slack-compatible webhook selected by the DSI).
DECROCHAGE_ALERT_WEBHOOK_URL=http://localhost:9999/alert-placeholder
