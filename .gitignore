# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Configuration locale / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Artefacts générés (modèles, figures) — régénérables par le notebook
artifacts/models/*.joblib
artifacts/figures/*.png
artifacts/*.db
artifacts/*.sqlite
artifacts/*.sqlite3
artifacts/mlflow-artifacts/
artifacts/mlflow-server/

# Données dérivées (les données brutes data/raw/ restent versionnées comme livrable)
data/processed/*.csv

# Sorties batch/API régénérables
reports/predictions.csv
reports/drift_report.json

# Playwright CLI (snapshots, logs, artefacts temporaires de démo)
.playwright-cli/

# Démo Docker — à personnaliser avant versionnement
docs/qa_docker_demo_prompt.md
reports/screenshots/docker/qa-docker-demo.webm

# Énoncé du cas d'usage : propriété de l'organisme de certification,
# conservé en local mais non redistribué sur le dépôt public
reports/Enonce_cas_usage.pdf

# OS / IDE
.DS_Store
~$*.pptx
.vscode/
.idea/
.claude/

# Mesures d'eco-conception (CodeCarbon) : dependantes de la machine
artifacts/ecodesign/
